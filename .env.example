APP_NAME=Society Maintenance Tracker
DATABASE_URL=sqlite:///./society.db
SECRET_KEY=change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=120
OVERDUE_DAYS=7
UPLOAD_DIR=uploads

# Optional default admin created on startup when both are present.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

# Optional email settings. If SMTP_HOST is empty, emails are logged only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_USE_TLS=true
